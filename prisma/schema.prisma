// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}
enum ClassStatus {
  DRAFT
  PUBLISHED
  ALL
}
enum Gender {
  MALE
  FEMALE
  OTHER
}
enum SchoolStatus{
  ACTIVE
  INACTIVE
  PENDING
}
enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
model User {
  id Int @id @default(autoincrement())
  name String
  email  String @unique
  password String
  role Role @default(STUDENT)
  refreshToken String @default("")
  created DateTime @default(now())
  isVerified Boolean @default(false)
  student Student?
  teacher Teacher?
  schoolId Int? 
  school   School?      @relation("School_User", fields: [schoolId], references: [id])
  passwordToken PasswordToken?
  schoolAdmin School? @relation("SchoolAdmin")
  sectionIncharge Section? @relation("SectionIncharge")
  sectionId Int?
  sectionStudent Section? @relation("SectionStudent",fields:[sectionId],references:[id])
  timeTable TimeTable[]
  @@index([isVerified,name])
}
model Student {
  id              String    @id @default(cuid())

  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth     DateTime?
  gender          Gender?

  address         String?

  guardianName    String?
  guardianPhone   String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("students")
}
model Teacher {
  id              String    @id @default(cuid())

  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeNumber  String?
  qualification   String?
  specialization  String?

  joiningDate     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("teachers")
}
model School {
  id          Int     @id @default(autoincrement())
  name        String
  address     String?
  ownerName   String
  ownerPhone  String
  ownerEmail  String
  status      SchoolStatus @default(INACTIVE)
  adminId     Int? @unique
  admin       User?      @relation("SchoolAdmin", fields: [adminId], references: [id])
  users       User[]   @relation("School_User")
  classes     Class[] 
  createdAt   DateTime     @default(now())
}

model Class {
  id Int @id @default(autoincrement())
  name String 
  status ClassStatus @default(DRAFT)
  sections Section[]
  subjects Subject[]  
  schoolId Int 
  school School @relation(fields: [schoolId], references: [id])
  @@unique([name,schoolId],name:"class_school")
}
model Section {
  id Int @id @default(autoincrement())
  name String 
  inchargeId Int? @unique
  incharge User? @relation("SectionIncharge", fields: [inchargeId], references: [id])
  students User[] @relation("SectionStudent")
  classId Int
  class Class @relation(fields: [classId], references: [id])
  @@unique([name,classId],name:"section_class")
  timeTable TimeTable[]
}
model Subject {
  id Int @id @default(autoincrement())
  name String 
  classId Int
  class Class @relation(fields: [classId], references: [id])
  timeTable TimeTable[]
  @@unique([name,classId],name:"subject_class")
}
model TimeTable {
  id Int @id @default(autoincrement())
  teacherId Int
  sectionId Int
  subjectId Int
  day WeekDay
  startTime Int
  endTime Int
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher User @relation(fields: [teacherId], references: [id])
  @@index([sectionId,day,startTime])
}
model Otp {
  id String @id @default(uuid())
  email String @unique
  hasdedCode String
  expiresAt  DateTime
  created DateTime @default(now())
}
model PasswordToken {
  id        Int      @id @default(autoincrement())
  userId    Int @unique
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}




