// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
enum SchoolStatus{
  ACTIVE
  INACTIVE
  PENDING
}
model User {
  id Int @id @default(autoincrement())
  name String
  email  String @unique
  password String
  role Role @default(STUDENT)
  refreshToken String @default("")
  created DateTime @default(now())
  isVerified Boolean @default(false)
  student Student?
  teacher Teacher?
  schoolId Int? 
  school   School?      @relation("School_User", fields: [schoolId], references: [id])
  schoolAdmin School? @relation("SchoolAdmin")
}
model Student {
  id              String    @id @default(cuid())

  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  dateOfBirth     DateTime?
  gender          Gender?

  address         String?

  guardianName    String?
  guardianPhone   String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("students")
}
model Teacher {
  id              String    @id @default(cuid())

  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeNumber  String?
  qualification   String?
  specialization  String?

  joiningDate     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("teachers")
}

model School {
  id          Int       @id @default(autoincrement())
  name        String
  address     String?
  ownerName   String
  ownerPhone  String
  ownerEmail  String
  status      SchoolStatus @default(INACTIVE)
  adminId     Int? @unique
  admin       User?      @relation("SchoolAdmin", fields: [adminId], references: [id])
  users       User[]   @relation("School_User")
  createdAt   DateTime     @default(now())
}



model Otp {
  id String @id @default(uuid())
  email String @unique
  hasdedCode String
  expiresAt  DateTime
  created DateTime @default(now())
}




